public class LargestArray {
    public static void main(String[] args) {

        int[] arr = {10, 25, 5, 40, 15};

        int large = arr[0];

        for (int i = 1; i < arr.length; i++) {
            if (arr[i] > large) {
                large = arr[i];
            }
        }

        System.out.println("Largest element = " + large);
    }
}